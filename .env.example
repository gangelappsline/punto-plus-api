APP_NAME="Punto Plus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# Necesario en desarrollo si se usa el fallback HTTP hacia /oauth/token
# (permite atender la petición interna sin bloquear el servidor de PHP).
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Base de datos: MySQL 8+ (por defecto) o PostgreSQL 14+
# ----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=punto_plus
DB_USERNAME=root
DB_PASSWORD=

# Alternativa rápida para desarrollo local / pruebas:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# ----------------------------------------------------------------------------
# Sesiones / caché / colas
# ----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ----------------------------------------------------------------------------
# Laravel Passport (OAuth2)
# ----------------------------------------------------------------------------
# Claves RSA: se generan con `php artisan passport:install`
# (contenido PEM inline sólo si no se usan archivos en storage/)
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
# PASSPORT_CONNECTION=
# Ruta alternativa a las claves (útil en contenedores de sólo lectura)
# PASSPORT_KEYS_PATH=

# ----------------------------------------------------------------------------
# Punto Plus: OAuth2 de la app móvil / negocio
# ----------------------------------------------------------------------------
# Cliente "password grant" que la API usa para /api/auth/login y /api/auth/refresh.
# Se generan con:  php artisan punto-plus:oauth-clients --write-env
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

# Emite tokens dentro del mismo proceso (recomendado). Si se pone en false la API
# hará una petición HTTP a OAUTH_TOKEN_URL o a {APP_URL}/oauth/token.
OAUTH_INTERNAL_DISPATCH=true
# OAUTH_TOKEN_URL=https://api.puntoplus.test/oauth/token

# Redirect URIs de la app móvil (Authorization Code + PKCE), separadas por coma.
OAUTH_MOBILE_REDIRECT_URIS="puntoplus://oauth/callback"

# Password grant: útil para clientes legacy/móviles propios. Puede desactivarse
# si sólo se usa Authorization Code + PKCE.
OAUTH_PASSWORD_GRANT_ENABLED=true

# Vigencia de tokens
OAUTH_ACCESS_TOKEN_MINUTES=1440
OAUTH_REFRESH_TOKEN_DAYS=30
OAUTH_PERSONAL_ACCESS_DAYS=90

# ----------------------------------------------------------------------------
# Punto Plus: reglas de tarjetas y sellos
# ----------------------------------------------------------------------------
CARD_DEFAULT_REQUIRED_STAMPS=10
CARD_STAMP_THROTTLE_SECONDS=30
CARD_MAX_STAMPS_PER_DAY=0
CARD_RESET_PROGRESS_ON_REDEEM=true
# CARD_STAMPS_LIFETIME_DAYS=

# Almacenamiento de assets (logo, fondo, sello): public | s3
PUNTO_PLUS_ASSET_DISK=public
PUNTO_PLUS_ASSET_MAX_KB=4096

# ----------------------------------------------------------------------------
# Resto de servicios
# ----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@puntoplus.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
